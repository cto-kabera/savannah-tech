# Neon connection string. Copy this file to .env and paste the real value.
# Neon dashboard → your project → Connect → Connection string.
# Do not commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Password for /portal. Required in Vercel so quote requests stay private.
PORTAL_PASSWORD=choose-a-long-staff-password
